# Backend Environment Variables
PORT=3000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/interview-ai?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini GenAI API Key (Get from Google AI Studio: https://aistudio.google.com/)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
